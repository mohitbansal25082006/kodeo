# .env.example
# ────────────────────────────────────────────────────────────
# KODEO — Environment Variables
# Copy this file to .env.local and fill in real values.
# Part 1a doesn't read any of these. Part 1b (auth) uses
# everything below. Part 1c (settings) will add a few more.
# ────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Neon Postgres, raw pg — no ORM)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/kodeo?sslmode=require"

# Better Auth
# Generate a secret with: npx @better-auth/cli secret
AUTH_SECRET="generate-with-npx-@better-auth/cli-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (github.com/settings/developers → New OAuth App)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend (email OTP for verification, sign-in, and password reset)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="KODEO <onboarding@yourdomain.com>"
