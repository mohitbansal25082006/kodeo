# ────────────────────────────────────────────────────────────
# KODEO — Environment Variables
# Copy this file to .env.local and fill in real values.
# ────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="https://kodeo.website"

# Database (Neon Postgres, raw pg — no ORM)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/kodeo?sslmode=require"

# Better Auth
# Generate a secret with: npx @better-auth/cli secret
AUTH_SECRET="generate-with-npx-@better-auth/cli-secret"
AUTH_URL="https://kodeo.website"

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials)
# Authorized redirect URI: https://kodeo.website/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (github.com/settings/developers → New OAuth App)
# Authorization callback URL: https://kodeo.website/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend (email OTP for verification, sign-in, password reset, and
# workspace invitations — see src/lib/email.ts)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="KODEO <onboarding@kodeo.website>"
